# =========================================
# RescueNexus — ALL backend settings live here
# -----------------------------------------
# Local:   copy this file to ".env" and fill in values
# Vercel:  add the same keys in Project > Settings > Environment Variables
# The real .env is git-ignored — never commit it.
# =========================================

# ---------- Database ----------
# Local PostgreSQL or a hosted one (Neon / Supabase)
DATABASE_URL=postgresql://postgres:root@localhost:5432/rescuenexus

# ---------- Email (Gmail) ----------
# EMAIL_APP_PASSWORD is a Gmail "App password", not your normal password
EMAIL_USER=rescuenexusniet@gmail.com
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SUBJECT=🚨 RescueNexus Emergency Alert

# ---------- SMS (Textbelt) ----------
# "textbelt" = free key (1 SMS/day). Paste a paid key to send more.
TEXTBELT_KEY=textbelt
TEXTBELT_URL=https://textbelt.com/text

# ---------- Links ----------
MAPS_LINK_TEMPLATE=https://maps.google.com/?q={lat},{lng}
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=RescueNexusApp

# ---------- Security ----------
# Comma-separated frontend origins allowed to call the API, or * for any
CORS_ORIGINS=*

# ---------- Map defaults (Streamlit admin) ----------
DEFAULT_MAP_LAT=28.4744
DEFAULT_MAP_LNG=77.5040
